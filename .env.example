# Copy to .env and fill in.  LIVE MODE ONLY.
#
#     cp .env.example .env
#
# The lab runs FULLY OFFLINE without any of this:
#
#     python3 run_lab.py          <- needs nothing below
#
# .env is read by the lab itself (stdlib — no python-dotenv, no pip install).
# Anything already exported in your shell WINS over this file.
# NEVER commit .env. It is in .gitignore for a reason.


# ===========================================================================
# LAYER 1 — AZURE OPENAI EMBEDDINGS          (python3 run_lab.py --live embed)
# ===========================================================================
# Replaces the simulated hashed vectors with real text-embedding-3-* vectors.
# Keeps the lab's own filterable index, so you are changing exactly ONE thing
# and can see what it did to each lever.

# Your Azure OpenAI / Foundry RESOURCE endpoint. Any of these forms works —
# the lab normalises it and prints what it resolved to.
#   https://my-resource.openai.azure.com
#   https://my-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/

AZURE_OPENAI_API_KEY=<your-key>

# WHICH OF THE TWO AZURE ROUTES YOUR RESOURCE SERVES.
#
#   UNSET  -> v1 route:      POST {endpoint}/openai/v1/embeddings
#                            body carries "model": "<deployment>"
#   SET    -> classic route: POST {endpoint}/openai/deployments/<dep>/embeddings
#                            ?api-version=...
#
# Symptom of guessing wrong: EVERY deployment name 404s with
# DeploymentNotFound, including ones you can see in the portal. That is not a
# missing deployment, it is the wrong route. Flip this before you believe the
# resource is empty.  (`python3 run_lab.py --probe` tries both and tells you.)
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# The two EMBEDDING deployment names on that resource. These are DEPLOYMENT
# names, which are whatever you called them in the portal — not model names.
# The lab's "small" and "large" levers map onto these.
AZURE_EMBED_DEPLOYMENT_SMALL=text-embedding-3-small
AZURE_EMBED_DEPLOYMENT_LARGE=text-embedding-3-large

# Native dimensions of each. text-embedding-3-small is 1536, -large is 3072.
# Both are Matryoshka-trained, so a truncated prefix is still a usable vector —
# which is what `--dims` measures.
AZURE_EMBED_DIMS_SMALL=1536
AZURE_EMBED_DIMS_LARGE=3072

# USD per 1M tokens. Illustrative — LOOK UP CURRENT PRICING, do not trust a
# number someone typed into a training repo.
AZURE_EMBED_PRICE_SMALL=0.02
AZURE_EMBED_PRICE_LARGE=0.13


# ===========================================================================
# LAYER 2 — AZURE AI SEARCH                 (python3 run_lab.py --live search)
# ===========================================================================
# The real thing: a real index, real filterable fields, a real OData $filter,
# real BM25, real HNSW vector search, real RRF hybrid fusion.

# Service NAME only, or the full endpoint — both accepted.
#   my-search-service            -> https://my-search-service.search.windows.net
#   https://my-search-service.search.windows.net
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net

# ADMIN key (not a query key). Provisioning the index needs admin rights.
# Portal: Search service > Settings > Keys > Primary admin key.
AZURE_SEARCH_API_KEY=<your-admin-key>

# Index name. Lowercase letters, digits and dashes only.
AZURE_SEARCH_INDEX=decisionstream-policy

# REST api-version. 2026-04-01 is the current STABLE version and is what this
# lab was verified against on 2026-08-12. Check it before you rely on it —
# Azure AI Search has changed its query shape across versions before, and
# `vectorQueries` itself was a breaking change from 2023-07-01-preview.
# strictPostFilter is preview-only; the lab uses this version ONLY for those
# queries and stays on the stable one for everything else.
AZURE_SEARCH_PREVIEW_API_VERSION=2026-05-01-preview

AZURE_SEARCH_API_VERSION=2026-04-01

# Which embedding lever `--live search` indexes with. Building an index per
# model costs an index slot AND a full re-embed, so the default builds one.
#
# Index slots by tier:  Free 3   Basic 15 (5 if created before Dec 2017)
#                       S1 50    S2/S3 200
# Check yours rather than guessing — `--live search` prints the live counters
# from GET /servicestats, which reports usage against your real quota.
AZURE_SEARCH_MODEL=large


# ===========================================================================
# NEGATIVE-QUERY CUTOFFS  (optional — measure, do not inherit)
# ===========================================================================
# Q10 asks for something the corpus does not contain; "correct" means the top
# hit is weak. Every scoring scale needs its own cutoff, and they are NOT
# interchangeable. Measure yours:
#
#   python3 run_lab.py --live embed  --calibrate
#   python3 run_lab.py --live search --calibrate
#
# Layer 1 — the lab's scoring over real embeddings.
# 0.25 is right for the SIMULATED vectors and wrong for real ones: real
# text-embedding-3 has a similarity floor around 0.15, so 0.25 sits below the
# noise and marks every result "strong".
# DS_NEG_EMBED_KEYWORD=0.25
# DS_NEG_EMBED_VECTOR=0.49
# DS_NEG_EMBED_HYBRID=0.34
#
# Layer 2 — Azure's own scoring. Note how little room the vector one has:
# measured separation between an answerable and an unanswerable query was
# 3.50 for BM25 and 0.062 for cosine.
# DS_NEG_BM25=1.75
# DS_NEG_VECTOR=0.62
# DS_NEG_HYBRID=0.025
